# Public origin used for OAuth callbacks, credential emails and browser-to-Drive CORS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas is the production source of truth. No automatic seed runs at startup.
MONGODB_URI=
MONGODB_DB_NAME=adventure
DEMO_MODE=false
DEMO_TEAM_PASSWORD=
SEED_ALLOW_PRODUCTION=false

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Google OAuth web application; callback path must match exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/admin/callback

# Gmail API transactional email (OAuth grant requires gmail.send scope).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Google Drive OAuth client and refresh token for the organizer account.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Event policy defaults (13 October 2026, Asia/Kolkata).
EVENT_TIMEZONE=Asia/Kolkata
EVENT_START_AT=2026-10-13T08:00:00.000Z
SUBMISSION_DEADLINE=2026-10-13T10:00:00.000Z
MAX_VIDEO_SIZE_BYTES=1610612736
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
